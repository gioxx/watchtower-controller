# Passed as-is to every Watchtower container (docker run --env-file).
# Any option from https://watchtower.nickfedor.com/ works here.
# This file holds secrets (notification URL): keep it chmod 600.

TZ=Europe/Rome

WATCHTOWER_LIFECYCLE_HOOKS=true
WATCHTOWER_CLEANUP=true

# false = update every container; opt a container out with the label
# com.centurylinklabs.watchtower.enable=false
WATCHTOWER_LABEL_ENABLE=false

# Uncomment to only report available updates, without applying them.
# WATCHTOWER_MONITOR_ONLY=true

# Notifications via Shoutrrr: https://containrrr.dev/shoutrrr/
WATCHTOWER_NOTIFICATIONS=shoutrrr
WATCHTOWER_NOTIFICATION_URL=telegram://TOKEN@telegram?chats=CHAT_ID

WATCHTOWER_LOG_LEVEL=info
WATCHTOWER_NO_STARTUP_MESSAGE=true
NO_COLOR=true
